# Local SQLite file database (default)
# For Vercel production, switch to Turso libSQL URL + Auth Token:
# DATABASE_URL="libsql://your-db-name.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"
DATABASE_URL="file:./data/cms.db"

# Auth
AUTH_SECRET="change-this-to-a-random-32-char-secret"
# Set to "true" in HTTPS/Vercel production; keep "false" on local HTTP Docker
COOKIE_SECURE="false"

# Compro Integration (On-Demand ISR Webhook & Public API)
COMPRO_URL="http://localhost:3000"
COMPRO_REVALIDATE_SECRET="change-this-shared-secret"
CMS_API_KEY="change-this-cms-api-key"
